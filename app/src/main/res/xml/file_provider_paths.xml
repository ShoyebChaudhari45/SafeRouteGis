<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider paths for sharing files generated by the app.
    Used when attaching report images to intents on API 24+.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- App's internal files/report_images/ directory -->
    <files-path
        name="report_images"
        path="report_images/" />
    <!-- Cache directory for temporary files -->
    <cache-path
        name="cache"
        path="." />
</paths>
