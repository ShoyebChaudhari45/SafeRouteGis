<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- ══════════════════════════════════════
         APP BAR  — single gradient block
    ══════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_gradient_primary">

            <!-- Toolbar -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbarAlerts"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:titleTextColor="@color/colorTextOnPrimary"
                app:navigationIconTint="#FFFFFF" />

            <!-- Subtitle row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_nav_alerts"
                    app:tint="#BBFFFFFF"
                    android:contentDescription="Alerts" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Real-time road safety reports"
                    android:textColor="#BBFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● LIVE"
                    android:textColor="#FFEB3B"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05" />

            </LinearLayout>

            <!-- ── Custom tab filter strip ── -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tabAll"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:tag="ALL"
                        android:text="All"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:background="@drawable/bg_tab_selected"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tabAccidents"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                                 android:tag="ACCIDENT"
                        android:text="Accidents"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:textColor="#CCFFFFFF"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:background="@drawable/bg_tab_unselected"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tabPotholes"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:tag="POTHOLE"
                        android:text="Potholes"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:textColor="#CCFFFFFF"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:background="@drawable/bg_tab_unselected"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tabConstruction"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:tag="CONSTRUCTION"
                        android:text="Construction"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:textColor="#CCFFFFFF"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:background="@drawable/bg_tab_unselected"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tabTraffic"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:tag="TRAFFIC"
                        android:text="Traffic"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:textColor="#CCFFFFFF"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:background="@drawable/bg_tab_unselected"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ══════════════════════════════════════
         RECYCLER VIEW
    ══════════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAlerts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- ══════════════════════════════════════
         EMPTY STATE
    ══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutAlertsEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="24dp">

            <View
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_icon_circle"
                android:alpha="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🛡️"
                android:textSize="40sp" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvAlertsEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_alerts"
            android:textColor="@color/colorTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All roads look safe right now.\nNo incidents reported in your area."
            android:textColor="@color/colorTextHint"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
