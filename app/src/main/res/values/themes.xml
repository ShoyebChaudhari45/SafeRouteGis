<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ════════════════════════════════════════════════════════════════
         Base Application Theme: Deep Blue + Teal, Material3
    ═════════════════════════════════════════════════════════════════ -->
    <style name="Base.Theme.SafeRouteGIS" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorTextOnPrimary</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryLight</item>
        <item name="colorOnPrimaryContainer">@color/colorPrimaryDark</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/colorTextOnAccent</item>
        <item name="colorSecondaryContainer">@color/colorAccentLight</item>
        <item name="colorOnSecondaryContainer">@color/colorTextPrimary</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorTextOnPrimary</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorOnBackground">@color/colorTextPrimary</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/colorBottomNavBg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.SafeRouteGIS" parent="Base.Theme.SafeRouteGIS" />

    <!-- ════════════════════════════════════════════
         Splash Screen (fullscreen gradient)
    ═════════════════════════════════════════════ -->
    <style name="Theme.SafeRouteGIS.Splash" parent="Base.Theme.SafeRouteGIS">
        <item name="android:windowBackground">@drawable/bg_splash_gradient</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">#0D47A1</item>
        <item name="android:navigationBarColor">#0097A7</item>
    </style>

    <!-- ════════════════════════════════════════════
         Toolbar
    ═════════════════════════════════════════════ -->
    <style name="Widget.SafeRouteGIS.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/colorPrimary</item>
        <item name="titleTextColor">@color/colorTextOnPrimary</item>
        <item name="subtitleTextColor">@color/colorPrimaryLight</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- ════════════════════════════════════════════
         Primary Button  (Pill shape, gradient)
    ═════════════════════════════════════════════ -->
    <style name="Widget.SafeRouteGIS.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorTextOnPrimary</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- ════════════════════════════════════════════
         Accent Button
    ═════════════════════════════════════════════ -->
    <style name="Widget.SafeRouteGIS.Button.Accent" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/colorAccent</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- ════════════════════════════════════════════
         Outlined Button
    ═════════════════════════════════════════════ -->
    <style name="Widget.SafeRouteGIS.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <!-- ════════════════════════════════════════════
         TextInputLayout  (Rounded outline)
    ═════════════════════════════════════════════ -->
    <style name="Widget.SafeRouteGIS.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="hintTextColor">@color/colorPrimary</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxStrokeWidth">1.5dp</item>
    </style>

    <!-- ════════════════════════════════════════════
         Card  (Higher radius, subtle shadow)
    ═════════════════════════════════════════════ -->
    <style name="Widget.SafeRouteGIS.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">6dp</item>
        <item name="cardBackgroundColor">@color/colorCardBg</item>
    </style>

    <!-- ════════════════════════════════════════════
         Bottom Navigation
    ═════════════════════════════════════════════ -->
    <style name="Widget.SafeRouteGIS.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/colorBottomNavBg</item>
        <item name="itemIconTint">@color/colorBottomNavInactive</item>
        <item name="itemTextColor">@color/colorBottomNavInactive</item>
        <item name="itemActiveIndicatorStyle">@null</item>
        <item name="android:elevation">12dp</item>
    </style>

    <!-- ════════════════════════════════════════════
         Bottom Navigation Active Indicator  (pill behind active icon)
    ═════════════════════════════════════════════ -->
    <style name="Widget.SafeRoute.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <!-- 12 % opacity primary blue pill -->
        <item name="android:color">#1F1565C0</item>
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
    </style>

    <!-- ════════════════════════════════════════════
         Bottom Navigation Text Appearances
    ═════════════════════════════════════════════ -->
    <style name="TextAppearance.SafeRoute.BottomNav.Active" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <style name="TextAppearance.SafeRoute.BottomNav.Inactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/colorBottomNavInactive</item>
    </style>

</resources>
