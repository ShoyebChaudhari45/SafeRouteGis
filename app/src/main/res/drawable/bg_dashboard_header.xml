<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0D47A1"
                android:centerColor="#1565C0"
                android:endColor="#0097A7"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>
    <!-- Subtle glass overlay at top -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#22FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
